/*
  # Security headers — Cloudflare Pages applies these to every response.
  # Content-Security-Policy restricts what the browser will execute/fetch
  # so that a bundle or dependency compromise can't quietly exfiltrate.
  # Supabase is the only backend; Google Fonts for Inter Tight;
  # accounts.google.com + gmail.googleapis.com for OAuth / Gmail send;
  # Google Calendar template URL is opened as a navigation target only.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://shuenqmzbrthiiokfzio.supabase.co wss://shuenqmzbrthiiokfzio.supabase.co https://accounts.google.com https://oauth2.googleapis.com https://gmail.googleapis.com https://script.google.com; frame-src https://accounts.google.com; form-action 'self' https://accounts.google.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Long cache for hashed build assets — filename changes on every build
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never edge-cache HTML. The in-app "New version available — Reload"
# banner polls /index.html for the latest bundle hash; if Cloudflare's
# edge serves a stale HTML, the hash never changes and the banner
# never fires. CDN-Cache-Control targets the CDN specifically;
# Cache-Control: no-store also tells the browser to revalidate.
/
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-store
  CDN-Cache-Control: no-store

# Service worker must also revalidate every load so SW updates ship
# within a tab's lifetime instead of being pinned to the cached copy.
/sw.js
  Cache-Control: no-store
  CDN-Cache-Control: no-store
